rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User data ──────────────────────────────────────────────────────────
    // Each signed-in user can read and write ONLY their own documents.
    // {document=**} is a recursive wildcard that covers ALL subcollections:
    //   bookmarks, notes, savedItems, likedAnswerIds, and anything added later.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Daily content cache ────────────────────────────────────────────────
    // Anyone can read daily entries, including people without an account: the
    // devotional is the same for everyone and contains nothing personal. Without
    // this, guests can't see the saved entry and the app generates a new one
    // with the AI every time they open the Daily tab.
    // Only signed-in users can write (the first user each day caches the
    // AI-generated entry for everyone else).
    match /dailyContent/{date} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Community: Scripture posts ─────────────────────────────────────────
    match /posts/{postId} {
      allow read, write: if request.auth != null;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Community: Gratitude posts ─────────────────────────────────────────
    match /gratitudePosts/{postId} {
      allow read, write: if request.auth != null;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Community: Prayer requests ─────────────────────────────────────────
    match /prayerRequests/{requestId} {
      allow read, write: if request.auth != null;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Community: Daily question answers ─────────────────────────────────
    match /dailyAnswers/{answerId} {
      allow read, write: if request.auth != null;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Collection group: answerLikes ──────────────────────────────────────
    // The app uses a collection-group query to find all answers a user has
    // liked across every dailyAnswers document. This rule enables that query.
    match /{path=**}/answerLikes/{likeId} {
      allow read, write: if request.auth != null;
    }

  }
}
